    <Version>1.0.0-local</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus" Version="0.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxDesktop.DBus\LinuxDesktop.DBus.csproj" />
  </ItemGroup>

</Project>
