<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinuxDesktop.Core\LinuxDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.2" />
    <PackageReference Include="Tmds.DBus.SourceGenerator" Version="0.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Olbrasoft.LinuxDesktop.DBus</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>Olbrasoft.LinuxDesktop.DBus</PackageId>
    <Version>1.0.0</Version>
    <Authors>Olbrasoft</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Olbrasoft/LinuxDesktop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Olbrasoft/LinuxDesktop</RepositoryUrl>
    <PackageTags>linux;desktop;dbus;gnome;integration;window;workspace;tmds</PackageTags>
    <Description>Linux desktop integration - D-Bus implementation using Tmds.DBus for GNOME Shell window and workspace management</Description>
  </PropertyGroup>

</Project>
